datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String   @id @db.VarChar(50)
  name      String   @db.VarChar(100)
  iconName  String   @db.VarChar(50)
  sortOrder Int      @default(0)
  games     Game[]
  createdAt DateTime @default(now())
}

model QuickCategory {
  id          String  @id @db.VarChar(50)
  label       String  @db.VarChar(100)
  iconName    String  @db.VarChar(50)
  color       String  @db.VarChar(30)
  bgGlow      String  @db.VarChar(50)
  actionType  String  @db.VarChar(20) // 'filter' | 'random' | 'tag'
  filterValue String? @db.VarChar(50)
  sortOrder   Int     @default(0)
}

model Game {
  id           String    @id @default(cuid()) @db.VarChar(50)
  slug         String    @unique @db.VarChar(100)
  title        String    @db.VarChar(150)
  subtitle     String?   @db.VarChar(150)
  description  String    @db.Text
  instructions String?   @db.Text
  thumbnail    String    @db.VarChar(255)
  banner       String?   @db.VarChar(255)
  categoryId   String    @db.VarChar(50)
  category     Category  @relation(fields: [categoryId], references: [id])
  categoryName String?   @db.VarChar(100)
  tags         String    @db.VarChar(255)
  badge        String?   @db.VarChar(30)
  isHot        Boolean   @default(false)
  isNew        Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  available    Boolean   @default(true)
  gameUrl      String    @db.VarChar(255)
  rating       Float     @default(5.0)
  playCount    String    @default("0") @db.VarChar(50)
  releaseDate  String?   @db.VarChar(50)
  developer    String?   @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([isHot])
  @@index([isFeatured])
}

model HeroSlide {
  id               String  @id @db.VarChar(100)
  gameSlug         String  @db.VarChar(100)
  title            String  @db.VarChar(150)
  subtitle         String  @db.VarChar(150)
  tagline          String  @db.VarChar(255)
  badge            String  @db.VarChar(50)
  image            String  @db.VarChar(255)
  ctaText          String  @db.VarChar(50)
  secondaryCtaText String  @db.VarChar(50)
  woodenSignLines  String  @db.Text
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
}

model PromoBanner {
  id          String  @id @db.VarChar(50)
  title       String  @db.VarChar(150)
  subtitle    String  @db.VarChar(150)
  buttonText  String  @db.VarChar(50)
  buttonColor String  @db.VarChar(30)
  buttonBg    String  @db.VarChar(150)
  image       String  @db.VarChar(255)
  iconName    String  @db.VarChar(50)
  iconColor   String  @db.VarChar(30)
  link        String  @db.VarChar(255)
  sortOrder   Int     @default(0)
}

model LeaderboardEntry {
  id         String   @id @default(cuid()) @db.VarChar(50)
  gameSlug   String   @db.VarChar(100)
  playerName String   @db.VarChar(50)
  score      Int
  combo      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([gameSlug, score])
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(50)
  username     String   @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(100)
  passwordHash String?  @db.VarChar(255)
  avatar       String?  @db.VarChar(255)
  role         String   @default("USER") @db.VarChar(20)
  createdAt    DateTime @default(now())
}
